<?xml version="1.0" encoding="UTF-8"?>
<!--
  【役割】バックエンドの設定ファイル（Maven）。使うライブラリの一覧と、ビルドの方法を書く。
  【なぜ必要か】画面側の package.json と同じ役割。ここに書いたライブラリを、Maven がインターネットからダウンロードしてくる。
  Spring Initializr が作ったひな形に、日本語のコメントを足したもの。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 親の設定。Spring Boot 4.0.8 の推奨する版のライブラリを、まとめて使えるようにする。
	     MyBatis が 4.1 系にまだ対応していないので、4.0 系の最新を使っている -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.8</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<!-- このプロジェクト自体の名前と版 -->
	<groupId>com.campfires</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>backend</name>
	<description>Campfires backend</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>

	<properties>
		<!-- 使う Java の版（長期サポート版の 21） -->
		<java.version>21</java.version>
		<!--
		  脆弱性の修正のため、Spring Boot が決めている版を、修正済みの版に上書きする（セキュリティの見直し）。
		  Spring Boot 4.0.8（4.1.1 も同じ）が使う版には、脆弱性が見つかっている（Trivy で検出）。
		  Spring Boot の新しい版で直ったら、この上書きは消す（docs/security.md を参照）
		  - Tomcat 11.0.24：CVE-2026-65182、CVE-2026-65905、CVE-2026-68525（重大）。11.0.25 以降で修正
		  - Jackson 3.1.5 / 2.21.5：CVE-2026-89407、CVE-2026-89425、CVE-2026-68497、CVE-2026-91776、CVE-2026-91777（高）など。
		    大きな・深い JSON によるサービス停止など。3.1.7 / 2.21.7 で修正
		-->
		<tomcat.version>11.0.26</tomcat.version>
		<jackson-bom.version>3.1.7</jackson-bom.version>
		<jackson-2-bom.version>2.21.7</jackson-2-bom.version>
	</properties>

	<dependencies>
		<!-- ========== アプリの動作に使うライブラリ ========== -->

		<!-- Flyway：テーブルの変更を、番号付きの SQL ファイル（db/migration）で管理する -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<!-- Spring Security：ログイン、権限、CSRF の対策、パスワードの変換（BCrypt） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<!--
		  Spring Session JDBC：ログインの状態（セッション）を、データベースに保存する（本番だけ使う）。
		  箱（コンテナ）を入れ替えたり、2つ以上に増やしたりしても、ログインが切れないようにするため
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-session-jdbc</artifactId>
		</dependency>
		<!-- Validation：送られてきたデータの入力チェック（@NotBlank、@Size など） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Spring Web（Web MVC）：API を受け付ける仕組み（@RestController など）と、JSON の変換 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Flyway で PostgreSQL を扱うための追加の部品 -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<!-- MyBatis：自分で書いた SQL（resources/mapper の XML）を、Java のメソッドから呼ぶ -->
		<dependency>
			<groupId>org.mybatis.spring.boot</groupId>
			<artifactId>mybatis-spring-boot-starter</artifactId>
			<version>4.0.1</version>
		</dependency>

		<!-- Docker Compose の対応：アプリの起動時に、compose.yaml のデータベースを自動で起動する（開発中だけ使う） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<!-- PostgreSQL につなぐための部品（ドライバー）。runtime は「動かすときだけ必要」という意味 -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- ========== 自動テストだけで使うライブラリ（scope が test） ========== -->

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- ログインした状態などを、テストで作るための道具 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- MockMvc：本物のサーバーを立てずに、API を呼ぶテストを書くための道具（JUnit 5 も含む） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Testcontainers：テストのときに、Docker で本物の PostgreSQL を動かす -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mybatis.spring.boot</groupId>
			<artifactId>mybatis-spring-boot-starter-test</artifactId>
			<version>4.0.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Spring Boot のアプリを、起動（./mvnw spring-boot:run）や、1つのファイルへのまとめ（jar）ができるようにする -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!--
					  ./mvnw spring-boot:run で起動したときだけ、dev（開発用）のプロファイルを使う。
					  dev のときは、開発用の最初のデータ（DevDataLoader）を入れる。jar にまとめた本番のアプリには影響しない
					-->
					<profiles>
						<profile>dev</profile>
					</profiles>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
