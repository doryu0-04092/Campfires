<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  【役割】パスワードの再設定のトークン（password_reset_tokens テーブル）の SQL（PasswordResetTokenMapper.java と、id の名前で結び付く）。
  【なぜ必要か】トークンの保存・確認・無効化を、SQL で行うため。有効期限は、データベースの今の日時（now()）で判断する。
  値は必ず #{名前} で渡す（SQL インジェクションの対策。${} は使わない）。
-->
<mapper namespace="com.campfires.auth.PasswordResetTokenMapper">

    <resultMap id="passwordResetToken" type="com.campfires.auth.PasswordResetToken">
        <constructor>
            <idArg column="id" name="id" javaType="_long"/>
            <arg column="user_id" name="userId" javaType="_long"/>
        </constructor>
    </resultMap>

    <!-- make_interval(mins => 30) は「30分」という長さ。今の日時に足して、有効期限にする -->
    <insert id="insert">
        INSERT INTO password_reset_tokens (user_id, token_hash, expires_at)
        VALUES (#{userId}, #{tokenHash}, now() + make_interval(mins => #{validMinutes}))
    </insert>

    <!--
      まだ使えるトークンだけを探す：変換した値が同じ、未使用（used_at が NULL）、期限内（expires_at が今より後）、
      アカウントが削除されていない。<include refid="usable"/> で、下の2つの SELECT に埋め込む
    -->
    <sql id="usable">
        SELECT t.id, t.user_id
        FROM password_reset_tokens t
        JOIN users u ON u.id = t.user_id
        WHERE t.token_hash = #{tokenHash}
          AND t.used_at IS NULL
          AND t.expires_at > now()
          AND u.deleted_at IS NULL
    </sql>

    <select id="findUsable" resultMap="passwordResetToken">
        <include refid="usable"/>
    </select>

    <!--
      FOR UPDATE OF t：トークンの行（t）だけをロックし、同じトークンでの再設定が同時に行われないようにする
      （2つ目の処理は、1つ目が終わるまで待ち、終わった後は「使用済み」なので見つからない）
    -->
    <select id="findUsableForUpdate" resultMap="passwordResetToken">
        <include refid="usable"/>
        FOR UPDATE OF t
    </select>

    <update id="invalidateUnusedByUserId">
        UPDATE password_reset_tokens SET used_at = now()
        WHERE user_id = #{userId} AND used_at IS NULL
    </update>

    <delete id="deleteByUserId">
        DELETE FROM password_reset_tokens WHERE user_id = #{userId}
    </delete>
</mapper>
